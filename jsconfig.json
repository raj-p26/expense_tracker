{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["./src/components/*"],
      "@components/*": ["./src/components/*"],
      "@ui/*": ["./src/ui/*"],
      "@styles": ["./src/styles/*"],
      "@src/*": ["./src/*"]
    },
    "module": "CommonJS",
    "target": "ES5",
    "checkJs": false
  },
  "exclude": ["node_modules"],
  "checkJs": false
}
